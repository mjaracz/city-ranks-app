{
  "rootDir": ".",
  "testEnvironment": "node",
  "roots": ["<rootDir>/apps", "<rootDir>/scripts"],
  "cacheDirectory": "<rootDir>/.codex/jest-repositories-cache",
  "extensionsToTreatAsEsm": [".ts"],
  "testMatch": [
    "**/*.repository.spec.ts",
    "**/open-meteo.provider.spec.ts",
    "**/load-metrics.spec.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "esModuleInterop": true,
          "ignoreDeprecations": "6.0",
          "types": ["jest", "node"]
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@libs/config$": "<rootDir>/libs/config/src/index.ts",
    "^@libs/config/(.*)$": "<rootDir>/libs/config/src/$1",
    "^@libs/contracts$": "<rootDir>/libs/contracts/src/index.ts",
    "^@libs/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
    "^@libs/messaging$": "<rootDir>/libs/messaging/src/index.ts",
    "^@libs/messaging/(.*)$": "<rootDir>/libs/messaging/src/$1",
    "^@libs/models$": "<rootDir>/libs/models/src/index.ts",
    "^@libs/models/(.*)$": "<rootDir>/libs/models/src/$1"
  }
}
