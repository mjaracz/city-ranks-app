{
  "name": "city-ranks-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "nest build api-gateway && nest build weather-worker && nest build activity-ranking-worker",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:weather-worker": "nest start weather-worker --watch",
    "start:dev:activity-ranking-worker": "nest start activity-ranking-worker --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:prod:weather-worker": "node dist/apps/weather-worker/main",
    "start:prod:activity-ranking-worker": "node dist/apps/activity-ranking-worker/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/tests/jest-e2e.json",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.integration.json --runInBand",
    "test:integration:gateway": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.integration.json --runInBand --runTestsByPath apps/api-gateway/tests/api-gateway.integration-spec.ts",
    "test:integration:weather": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.integration.json --runInBand --runTestsByPath apps/weather-worker/tests/weather-worker.integration-spec.ts",
    "test:integration:activity-ranking": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.integration.json --runInBand --runTestsByPath apps/activity-ranking-worker/tests/activity-ranking-worker.integration-spec.ts",
    "test:repositories": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.repositories.json --runInBand",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:integration:repositories": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.integration.json --runInBand --runTestsByPath apps/tests/persistence.integration-spec.ts",
    "db:migrate:activity-ranking": "ts-node scripts/migrate-activity-ranking.ts",
    "load:up": "docker compose -p city-ranks-load -f compose.load.yaml up -d --wait",
    "load:build": "tsc -p tsconfig.load.json",
    "load:workers": "node .codex/load-build/scripts/load/worker-load.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/microservices": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.14.2",
    "knex": "^3.1.0",
    "mongodb": "^7.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@rspack/core": "2.2.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "types": [
              "jest",
              "node"
            ],
            "ignoreDeprecations": "6.0"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./.codex/coverage",
    "cacheDirectory": "./.codex/jest-cache",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/scripts/"
    ]
  }
}
