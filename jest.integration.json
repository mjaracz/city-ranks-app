{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "cacheDirectory": "<rootDir>/.codex/jest-integration-cache",
  "testRegex": "\\.integration-spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "types": ["jest", "node"],
          "allowSyntheticDefaultImports": true,
          "esModuleInterop": true
        }
      }
    ]
  },
  "setupFiles": ["<rootDir>/apps/jest-integration.setup.ts"],
  "roots": ["<rootDir>/apps/"]
}
